{
  "name": "protondeck",
  "version": "0.4.0",
  "private": true,
  "description": "App desktop (Electron) de configs Proton da biblioteca Steam — IPC + Vue 3 + SQLite (better-sqlite3).",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/rmarquespaixao-eng/protondeck",
  "author": "rafael <assinaturashome2026@gmail.com>",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "sync": "tsx src/adapters/in/cli/sync.command.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.3.9",
    "openai": "^6.42.0",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "build": {
    "appId": "com.homelab.protondeck",
    "productName": "ProtonDeck",
    "publish": [
      {
        "provider": "github",
        "owner": "rmarquespaixao-eng",
        "repo": "protondeck",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "rafael <assinaturashome2026@gmail.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}