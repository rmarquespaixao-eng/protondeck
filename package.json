{
  "name": "protondeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard self-hosted de configs Proton da biblioteca Steam (monolito Fastify+TS+SQLite).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "sync": "tsx src/adapters/in/cli/sync.command.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "release": "bash scripts/build-release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@fastify/formbody": "^8.0.1",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^8.0.1",
    "@fastify/view": "^10.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.3.0",
    "ejs": "^3.1.10",
    "fastify": "^5.0.0",
    "openai": "^6.37.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.7.4",
    "playwright": "^1.60.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
