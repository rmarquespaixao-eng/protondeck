<%- include('partials/shell-top.ejs', { title: 'Vai rodar?', active: 'check', currentUser: currentUser }) %>

<div class="page-header">
  <h1>Vai rodar no Linux?</h1>
  <span class="page-sub">Busca um jogo na Steam (mesmo que não esteja na sua biblioteca) e te diz se vale comprar — combina ProtonDB, PCGamingWiki e Steam Store API.</span>
</div>

<div class="check-search-box">
  <input type="search" id="check-q" placeholder="ex: Resident Evil 4, Cyberpunk, Helldivers..." autofocus autocomplete="off" />
  <button type="button" id="check-search-btn">Buscar</button>
</div>

<div id="check-results"></div>
<div id="check-detail"></div>

<script>
(function() {
  var qEl    = document.getElementById('check-q');
  var btn    = document.getElementById('check-search-btn');
  var resEl  = document.getElementById('check-results');
  var detEl  = document.getElementById('check-detail');
  var debounceT = null;

  var REC_META = {
    'go':         { label: 'Vai rodar',         cls: 'rec-go',      icon: '✓' },
    'caution':    { label: 'Roda mas exige tweaks', cls: 'rec-caution', icon: '⚠' },
    'risky':      { label: 'Risco alto',        cls: 'rec-risky',   icon: '✕' },
    'unreleased': { label: 'Não lançado',       cls: 'rec-unreleased', icon: '⏳' },
    'no-data':    { label: 'Sem dados',         cls: 'rec-nodata',  icon: '?' }
  };

  var TIER_COLOR = {
    platinum: '#d6d6d6', gold: '#f5b942', silver: '#c0c0c0',
    bronze: '#cd7f32', borked: '#ff5a5a', native: '#8be39a', pending: '#888'
  };

  function escapeHTML(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
    });
  }

  function search() {
    var q = qEl.value.trim();
    if (q.length < 2) { resEl.innerHTML = ''; return; }
    resEl.innerHTML = '<p class="check-loading">buscando…</p>';
    fetch('/api/check/search?q=' + encodeURIComponent(q))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var hits = data.results || [];
        if (!hits.length) { resEl.innerHTML = '<p class="check-empty">nenhum resultado pra "' + escapeHTML(q) + '"</p>'; return; }
        resEl.innerHTML = '<div class="check-hits">' + hits.map(function(h) {
          return '<button type="button" class="check-hit" data-appid="' + escapeHTML(h.appid) + '" data-name="' + escapeHTML(h.name) + '">' +
            (h.logo ? '<img src="' + escapeHTML(h.logo) + '" alt="" />' : '<div class="check-hit-noimg"></div>') +
            '<div class="check-hit-meta">' +
              '<div class="check-hit-name">' + escapeHTML(h.name) + '</div>' +
              '<div class="check-hit-appid">appid ' + escapeHTML(h.appid) + '</div>' +
            '</div>' +
          '</button>';
        }).join('') + '</div>';
        resEl.querySelectorAll('.check-hit').forEach(function(el) {
          el.addEventListener('click', function() { loadDetail(el.dataset.appid, el.dataset.name); });
        });
      })
      .catch(function(err) {
        resEl.innerHTML = '<p class="check-err">erro: ' + escapeHTML(err.message) + '</p>';
      });
  }

  function loadDetail(appid, name) {
    detEl.innerHTML = '<div class="check-detail-card"><p class="check-loading">consultando ProtonDB + PCGamingWiki + Steam Store…</p></div>';
    detEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    fetch('/api/check/' + encodeURIComponent(appid))
      .then(function(r) { return r.json(); })
      .then(renderDetail)
      .catch(function(err) {
        detEl.innerHTML = '<div class="check-detail-card"><p class="check-err">erro: ' + escapeHTML(err.message) + '</p></div>';
      });
  }

  function platformBadge(label, on) {
    return '<span class="check-platform ' + (on ? 'check-platform-on' : 'check-platform-off') + '">' + label + '</span>';
  }

  function tierBadge(tier) {
    var color = TIER_COLOR[tier] || '#888';
    return '<span class="check-tier" style="background:' + color + ';color:#0a0d12">' + escapeHTML(tier) + '</span>';
  }

  function pcgwLine(label, f) {
    if (!f) return label + ': <span class="check-muted">sem info</span>';
    return label + ': <span class="check-pcgw-' + escapeHTML(f.state) + '">' + escapeHTML(f.state) + '</span>' +
      (f.notes ? ' — <span class="check-muted">' + escapeHTML(f.notes) + '</span>' : '');
  }

  function renderDetail(d) {
    var meta = REC_META[d.recommendation] || REC_META['no-data'];
    var store = d.store || {};
    var proton = d.protondb || {};
    var pcgw = d.pcgw || { features: {} };
    var platforms = store.platforms || { windows: false, mac: false, linux: false };

    var html = '<div class="check-detail-card">';
    html += '<div class="check-recommendation ' + meta.cls + '">' +
      '<span class="check-rec-icon">' + meta.icon + '</span>' +
      '<span class="check-rec-label">' + meta.label + '</span>' +
    '</div>';

    if (store.headerImage) html += '<img class="check-header-img" src="' + escapeHTML(store.headerImage) + '" alt="" />';

    html += '<div class="check-detail-body">';
    html += '<h2 class="check-game-name">' + escapeHTML(store.name || d.appid) + '</h2>';

    var sub = [];
    if (store.releaseDate) sub.push((store.comingSoon ? 'lança ' : 'lançado ') + escapeHTML(store.releaseDate));
    if (store.developers && store.developers.length) sub.push('dev: ' + escapeHTML(store.developers.join(', ')));
    if (store.priceFormatted) sub.push(escapeHTML(store.priceFormatted));
    else if (store.isFree) sub.push('grátis');
    if (sub.length) html += '<p class="check-sub">' + sub.join(' · ') + '</p>';

    if (store.shortDescription) html += '<p class="check-desc">' + escapeHTML(store.shortDescription) + '</p>';

    html += '<div class="check-section">';
    html += '<div class="check-section-title">Plataformas (declarado pela Steam)</div>';
    html += '<div class="check-platforms">' +
      platformBadge('Windows', platforms.windows) +
      platformBadge('Linux nativo', platforms.linux) +
      platformBadge('macOS', platforms.mac) +
    '</div>';
    html += '</div>';

    html += '<div class="check-section">';
    html += '<div class="check-section-title">ProtonDB</div>';
    if (proton.found) {
      html += '<div class="check-protondb">' +
        tierBadge(proton.tier) +
        (proton.trendingTier && proton.trendingTier !== proton.tier ? ' <span class="check-muted">trend: ' + escapeHTML(proton.trendingTier) + '</span>' : '') +
        ' · <span class="check-muted">' + proton.total + ' relatos</span>' +
        (proton.confidence ? ' · <span class="check-muted">confiança: ' + escapeHTML(proton.confidence) + '</span>' : '') +
      '</div>' +
      '<p class="check-muted"><a href="https://www.protondb.com/app/' + escapeHTML(d.appid) + '" target="_blank" rel="noopener">Ver relatos completos no ProtonDB ↗</a></p>';
    } else {
      html += '<p class="check-muted">Sem dados (jogo pode ser muito novo ou ter poucos relatos).</p>';
    }
    html += '</div>';

    html += '<div class="check-section">';
    html += '<div class="check-section-title">PCGamingWiki · suporte a resolução</div>';
    html += '<ul class="check-pcgw-list">';
    html += '<li>' + pcgwLine('Ultra-widescreen 21:9', pcgw.features.ultrawidescreen) + '</li>';
    html += '<li>' + pcgwLine('Widescreen 16:9', pcgw.features.widescreen) + '</li>';
    html += '<li>' + pcgwLine('Multi-monitor', pcgw.features.multimonitor) + '</li>';
    html += '<li>' + pcgwLine('4K Ultra HD', pcgw.features['4k']) + '</li>';
    html += '<li>' + pcgwLine('FOV ajustável', pcgw.features.fov) + '</li>';
    html += '</ul>';
    if (pcgw.pageUrl) html += '<p class="check-muted"><a href="' + escapeHTML(pcgw.pageUrl) + '" target="_blank" rel="noopener">Página do jogo no PCGamingWiki ↗</a></p>';
    html += '</div>';

    if (d.reasons && d.reasons.length) {
      html += '<div class="check-section">';
      html += '<div class="check-section-title">Por quê</div>';
      html += '<ul class="check-reasons">' + d.reasons.map(function(r) { return '<li>' + escapeHTML(r) + '</li>'; }).join('') + '</ul>';
      html += '</div>';
    }

    html += '<p class="check-muted check-footer">' +
      '<a href="https://store.steampowered.com/app/' + escapeHTML(d.appid) + '" target="_blank" rel="noopener">Abrir na Steam ↗</a>' +
    '</p>';

    html += '</div></div>';
    detEl.innerHTML = html;
  }

  qEl.addEventListener('input', function() {
    clearTimeout(debounceT);
    debounceT = setTimeout(search, 350);
  });
  qEl.addEventListener('keydown', function(e) { if (e.key === 'Enter') { clearTimeout(debounceT); search(); } });
  btn.addEventListener('click', search);
})();
</script>

<%- include('partials/shell-bot.ejs') %>
