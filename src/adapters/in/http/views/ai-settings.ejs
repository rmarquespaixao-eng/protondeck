<%- include('partials/shell-top.ejs', { title: 'AI Settings', active: 'ai' }) %>

<div class="page-header">
  <h1>AI Provider</h1>
  <span class="page-sub">Configure provider e modelo para Diagnosticar / Sugerir / Resolver problema com IA.</span>
</div>

<p class="meta" style="margin-bottom:12px">O system prompt do agente é cacheado por 5 minutos no Anthropic (cache_control ephemeral), reduzindo o custo de cada chamada repetida em ~90%. OpenAI cacheia automaticamente prompts &gt; 1024 tokens.</p>

<form method="post" action="/settings/ai" class="ai-settings-form">

  <label>
    Provider
    <select name="provider" id="provider-select" required>
      <% const providers = [
        ['anthropic', 'Anthropic (Claude) — cache + tools recomendado'],
        ['openai',    'OpenAI (GPT) — cache automático + tools'],
        ['ollama',    'Ollama (local — sem custo, sem tools)'],
      ]; %>
      <% providers.forEach(function(p) { %>
        <option value="<%= p[0] %>" <%= cfg && cfg.provider === p[0] ? 'selected' : '' %>><%= p[1] %></option>
      <% }); %>
    </select>
  </label>

  <label>
    Modelo
    <select name="model" id="model-select" required></select>
    <span class="hint" id="model-note"></span>
  </label>

  <label id="key-label">
    API Key
    <input type="password" name="api_key" autocomplete="off"
      value="<%= cfg && cfg.api_key ? cfg.api_key : '' %>"
      placeholder="cole a chave aqui" />
    <span class="hint">Salva localmente no SQLite. Nunca exposta ao frontend.</span>
  </label>

  <label>
    Base URL (opcional)
    <input type="text" name="base_url"
      value="<%= cfg && cfg.base_url ? cfg.base_url : '' %>"
      placeholder="(usa padrão do provider)" />
    <span class="hint" id="baseurl-hint"></span>
  </label>

  <div class="actions" style="margin-top:16px">
    <button type="submit">Salvar</button>
  </div>
</form>

<% if (cfg) { %>
<p class="meta" style="margin-top:24px">
  Última atualização: <%= cfg.updated_at %> · Atualmente: <strong><%= cfg.provider %>/<%= cfg.model %></strong>
</p>
<% } %>

<details class="system" style="margin-top:24px">
  <summary>Como usar</summary>
  <ul style="color:var(--muted);font-size:13px">
    <li><strong>Anthropic:</strong> gere chave em <code>console.anthropic.com</code> → API Keys. <strong>Cache + tools</strong> habilitados — economia máxima de tokens.</li>
    <li><strong>OpenAI:</strong> gere chave em <code>platform.openai.com/api-keys</code>. Cache automático nos prompts longos.</li>
    <li><strong>Ollama (local):</strong> instale <code>ollama</code> e rode <code>ollama pull qwen2.5-coder:7b</code>. Zero custo. <strong>Sem tools</strong> — usa só single-shot.</li>
    <li>Cache de resposta no SQLite: 24h por (jogo + provider + modelo + config). Repetições não custam.</li>
  </ul>
</details>

<script>
  var MODELS = <%- JSON.stringify(providerModels) %>;
  var DEFAULT_BASE_URLS = <%- JSON.stringify(defaultBaseUrls) %>;
  var current = <%- JSON.stringify(cfg || null) %>;

  var providerSel = document.getElementById('provider-select');
  var modelSel    = document.getElementById('model-select');
  var modelNote   = document.getElementById('model-note');
  var baseHint    = document.getElementById('baseurl-hint');
  var keyLabel    = document.getElementById('key-label');

  function refresh() {
    var prov = providerSel.value;
    modelSel.innerHTML = '';
    (MODELS[prov] || []).forEach(function(m) {
      var opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.label + (m.note ? ' — ' + m.note : '');
      if (current && current.provider === prov && current.model === m.id) opt.selected = true;
      modelSel.appendChild(opt);
    });
    baseHint.textContent = 'Padrão: ' + DEFAULT_BASE_URLS[prov];
    keyLabel.style.opacity = prov === 'ollama' ? '0.5' : '1';
    keyLabel.querySelector('.hint').textContent = prov === 'ollama'
      ? 'Ollama local não precisa de chave. Deixe vazio.'
      : 'Salva localmente no SQLite. Nunca exposta ao frontend.';
  }

  providerSel.addEventListener('change', refresh);
  refresh();
</script>

<%- include('partials/shell-bot.ejs') %>
